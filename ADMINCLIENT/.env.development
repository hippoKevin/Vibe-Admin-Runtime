# 项目打开地址
# localhost
VITE_OPEN_CLIENT = 0.0.0.0
# 项目打开端口
VITE_OPEN_CLIENT_PORT = 5009

# 项目测试阶段配置
VITE_DEVELOPMENT_SERVER_URL = 127.0.0.1:5004

# 后端接口地址
VITE_SERVER_URL = 127.0.0.1:5004

# 前端 Mock 模式（仅开发环境生效）：
#   false = 关闭，全部请求后端（联调真实后端时用这个最彻底）
#   auto  = 先请求后端，后端不可用/报错时才自动用 mock/ 数据
#   true / 1 / force = 纯 Mock，完全不请求后端（纯前端演示时用）
VITE_ENABLE_MOCK = auto
